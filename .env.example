# Copy to .env and fill in. Real environment variables take priority.

# Posters + artwork (free key from themoviedb.org > Settings > API)
TMDB_API_KEY=

# Set a long random value when deploying
JWT_SECRET=

# Relay for when the stream is stuck on "Connecting" (free: dash.cloudflare.com > Realtime > TURN Server)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Or any other TURN server
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=
# TURN_PASS=
